<launch>
  <arg name="image_topic" default="/camera/image_raw" />
  <arg name="camera_info_topic" default="/camera/camera_info" />
  <arg name="camera_frame" default="camera" />
  <arg name="marker_size" default="0.08" />
  <arg name="dictionary" default="DICT_6X6_250" />

  <node pkg="robot_vision" type="aruco_pose_node" name="aruco_pose_node" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="camera_frame" value="$(arg camera_frame)" />
    <param name="marker_size" value="$(arg marker_size)" />
    <param name="dictionary" value="$(arg dictionary)" />
  </node>
</launch>
